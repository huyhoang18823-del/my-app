<Window x:Class="ElevenLabsWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ElevenLabs TTS"
        Width="1200"
        Height="800"
        Background="#111111"
        Foreground="#F5F5F5"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="ButtonBrush" Color="#2F6FED"/>
        <SolidColorBrush x:Key="ButtonForegroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#AAAAAA"/>
        <SolidColorBrush x:Key="InputBackgroundBrush" Color="#2A2A2A"/>
        <SolidColorBrush x:Key="InputBorderBrush" Color="#555555"/>
        <SolidColorBrush x:Key="ProgressBackgroundBrush" Color="#2A2A2A"/>
        <LinearGradientBrush x:Key="PlayGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF7E3F" Offset="0"/>
            <GradientStop Color="#9B4DFF" Offset="1"/>
        </LinearGradientBrush>
        <ControlTemplate x:Key="PlayPauseTemplate" TargetType="Button">
            <Grid>
                <Ellipse Stroke="{StaticResource PlayGradient}" StrokeThickness="3" Width="60" Height="60"/>
                <Ellipse Fill="White" Width="50" Height="50"/>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#111111" FontSize="20"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.8"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- API SETTINGS -->
        <GroupBox Header="ElevenLabs API Settings" Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="#444444" Foreground="White" Padding="15" Margin="0 0 0 15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="API Key:" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtApiKey" Grid.Row="0" Grid.Column="1" Margin="5"
                         Background="{StaticResource InputBackgroundBrush}"
                         Foreground="{StaticResource TextBrush}"
                         BorderBrush="{StaticResource InputBorderBrush}"/>

                <TextBlock Grid.Row="0" Grid.Column="2" Text="Proxy:" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtProxy" Grid.Row="0" Grid.Column="3" Margin="5"
                         Background="{StaticResource InputBackgroundBrush}"
                         Foreground="{StaticResource TextBrush}"
                         BorderBrush="{StaticResource InputBorderBrush}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Voice ID:" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtVoiceId" Grid.Row="1" Grid.Column="1" Margin="5"
                         Background="{StaticResource InputBackgroundBrush}"
                         Foreground="{StaticResource TextBrush}"
                         BorderBrush="{StaticResource InputBorderBrush}"/>

                <Button x:Name="BtnCheckCredit" Grid.Row="1" Grid.Column="2" Content="Check Credit" Click="BtnCheckCredit_Click"
                        Background="{StaticResource ButtonBrush}"
                        Foreground="{StaticResource ButtonForegroundBrush}"
                        BorderBrush="{StaticResource ButtonBrush}" Margin="5" Padding="10 6"/>

                <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Vertical" Margin="5">
                    <TextBlock x:Name="TxtCredit" Text="Credit: 0 / 10000" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtStatus" Text="Ready" Foreground="{StaticResource MutedTextBrush}" FontSize="12"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- INPUT + AUDIO + HISTORY -->
        <GroupBox x:Name="InputGroup" Grid.Row="1" Header="Số ký tự: 0 | Ước tính Credit tiêu: 0" Background="{StaticResource PanelBrush}" BorderBrush="#444444" Foreground="White" Padding="15" Margin="0 0 0 15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0 0 0 10">
                    <TextBox x:Name="TxtText" TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" DockPanel.Dock="Top"
                             FontSize="14"
                             Background="{StaticResource InputBackgroundBrush}"
                             Foreground="{StaticResource TextBrush}"
                             BorderBrush="{StaticResource InputBorderBrush}"
                             TextChanged="TxtText_TextChanged"/>
                </DockPanel>

                <!-- Audio Controls -->
                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Vertical" Margin="0 10 10 0">
                    <Slider x:Name="AudioSlider" Minimum="0" Maximum="1" Value="0" Margin="0 0 0 8"
                            ValueChanged="AudioSlider_ValueChanged"
                            PreviewMouseLeftButtonDown="AudioSlider_PreviewMouseDown"
                            PreviewMouseLeftButtonUp="AudioSlider_PreviewMouseUp"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 0 0 6">
                        <TextBlock x:Name="TxtAudioTime" Text="00:00 / 00:00"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
                        <Button x:Name="BtnReplay" Content="⏪ 5s" Click="BtnReplay_Click"
                                Background="{StaticResource ButtonBrush}" Foreground="{StaticResource ButtonForegroundBrush}"
                                BorderBrush="{StaticResource ButtonBrush}" Padding="12 8"/>
                        <Button x:Name="BtnPlayPause" Content="▶" Click="BtnPlayPause_Click" Width="70" Height="70"
                                Template="{StaticResource PlayPauseTemplate}"/>
                        <Button x:Name="BtnForward" Content="5s ⏩" Click="BtnForward_Click"
                                Background="{StaticResource ButtonBrush}" Foreground="{StaticResource ButtonForegroundBrush}"
                                BorderBrush="{StaticResource ButtonBrush}" Padding="12 8"/>
                    </StackPanel>
                </StackPanel>

                <!-- Generate & Progress -->
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Right" Margin="0 10 0 0">
                    <Button x:Name="BtnGenerate" Content="Tạo" Width="180" Height="42" Click="BtnGenerate_Click"
                            Background="{StaticResource ButtonBrush}" Foreground="{StaticResource ButtonForegroundBrush}"
                            BorderBrush="{StaticResource ButtonBrush}" Margin="0 0 0 8"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                        <ProgressBar x:Name="LoadingBar" Width="220" Height="18" Minimum="0" Maximum="100" Value="0"
                                     Foreground="{StaticResource ButtonBrush}" Background="{StaticResource ProgressBackgroundBrush}"/>
                        <TextBlock x:Name="TxtLoadingPercent" Text="0%" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- History List -->
                <GroupBox Grid.Row="2" Grid.ColumnSpan="2" Header="History" Background="{StaticResource PanelBrush}" BorderBrush="#444444" Foreground="White" Margin="0 10 0 0">
                    <ListBox x:Name="HistoryList" Background="{StaticResource InputBackgroundBrush}"
                             Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource InputBorderBrush}"/>
                </GroupBox>
            </Grid>
        </GroupBox>

        <!-- LOADING BAR PLACEHOLDER ROW (unused) -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
            <TextBlock Text="Loading:" Margin="0 0 10 0"/>
            <ProgressBar Width="300" Height="18" Minimum="0" Maximum="100" Value="0"
                         Foreground="{StaticResource ButtonBrush}" Background="{StaticResource ProgressBackgroundBrush}"/>
            <TextBlock Text="0%" Margin="10 0"/>
        </StackPanel>

        <!-- SAVE SECTION -->
        <GroupBox Grid.Row="3" Header="Save To File" Background="{StaticResource PanelBrush}" BorderBrush="#444444" Foreground="White" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Save to:" VerticalAlignment="Center" Margin="0 0 10 0"/>
                <TextBox x:Name="TxtSavePath" Grid.Column="1" IsReadOnly="True" Margin="5"
                         Background="{StaticResource InputBackgroundBrush}"
                         Foreground="{StaticResource TextBrush}"
                         BorderBrush="{StaticResource InputBorderBrush}"/>
                <Button Grid.Column="2" Content="Browse" Click="BtnBrowse_Click"
                        Background="{StaticResource ButtonBrush}" Foreground="{StaticResource ButtonForegroundBrush}"
                        BorderBrush="{StaticResource ButtonBrush}" Margin="5" Padding="10 6"/>
                <Button Grid.Column="3" Content="Lưu" Click="BtnSaveFile_Click"
                        Background="{StaticResource ButtonBrush}" Foreground="{StaticResource ButtonForegroundBrush}"
                        BorderBrush="{StaticResource ButtonBrush}" Margin="5" Padding="10 6"/>
            </Grid>
        </GroupBox>
    </Grid>
</Window>
