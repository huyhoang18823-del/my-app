<Window x:Class="YtScraper.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YouTube Channel Scraper" Height="520" Width="820">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="YouTube Data API v3 Key:" Grid.Row="0" Grid.Column="0" Margin="0,6" VerticalAlignment="Center"/>
        <PasswordBox x:Name="ApiKeyBox" Grid.Row="0" Grid.Column="1" Margin="8,4"/>

        <TextBlock Text="YouTube Channel URL / Handle:" Grid.Row="1" Grid.Column="0" Margin="0,6" VerticalAlignment="Center"/>
        <TextBox x:Name="UrlBox" Grid.Row="1" Grid.Column="1" Margin="8,4"/>

        <TextBlock Text="Max Videos:" Grid.Row="2" Grid.Column="0" Margin="0,6" VerticalAlignment="Center"/>
        <TextBox x:Name="MaxBox" Grid.Row="2" Grid.Column="1" Margin="8,4" Text="100" Width="120"/>

        <TextBlock Text="Save Folder:" Grid.Row="3" Grid.Column="0" Margin="0,6" VerticalAlignment="Center"/>
        <TextBox x:Name="FolderBox" Grid.Row="3" Grid.Column="1" Margin="8,4"/>
        <Button Content="Browse" Grid.Row="3" Grid.Column="2" Margin="8,4" Padding="16,4" Click="Browse_Click"/>

        <Button x:Name="StartBtn"
                Content="Start Scraping"
                Grid.Row="4"
                Grid.ColumnSpan="3"
                Margin="0,10"
                Click="Start_Click"
                Height="36"/>

        <TextBlock Text="Progress Log:" Grid.Row="5" Grid.Column="0" Margin="0,6,0,0" VerticalAlignment="Bottom"/>
        <TextBox x:Name="LogBox"
                 Grid.Row="6"
                 Grid.ColumnSpan="3"
                 Margin="0,12,0,0"
                 VerticalScrollBarVisibility="Auto"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 IsReadOnly="True"
                 HorizontalScrollBarVisibility="Disabled"/>
    </Grid>
</Window>
